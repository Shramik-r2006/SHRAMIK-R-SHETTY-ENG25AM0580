class Solution {
    public String reversePrefix(String word, char ch) {
        int idx = 0;
        StringBuilder ans = new StringBuilder();
        for (int i = 0; i < word.length(); i++) {
            if (word.charAt(i) == ch) {
                idx = i;
                break;
            }
        }
        for (int j = idx; j >= 0; j--) {
            ans.append(word.charAt(j));
        }
        for (int k = idx + 1; k < word.length(); k++) {
            ans.append(word.charAt(k));
        }
        return ans.toString();
    }
}
